{
  "name": "SDI Integration (Qt 6)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "..",
    "target": "dev"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "cmake.sourceDirectory": "${workspaceFolder}/code",
        "cmake.buildDirectory": "${workspaceFolder}/build",
        "cmake.generator": "Ninja"
      }
    }
  }
}
